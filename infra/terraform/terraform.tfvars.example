# Copy to terraform.tfvars and fill in real values. Never commit
# terraform.tfvars, it is excluded by .gitignore.

aws_region      = "us-east-1"
project_name    = "visionops"
environment     = "dev"

db_password     = "change-me-to-a-strong-password"

backend_image   = "123456789012.dkr.ecr.us-east-1.amazonaws.com/visionops-backend:latest"
frontend_image  = "123456789012.dkr.ecr.us-east-1.amazonaws.com/visionops-frontend:latest"
