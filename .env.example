# Copy this file to .env in the project root before running docker compose up.
# Every service in docker-compose.yml reads its configuration from these
# variables so the whole stack can be reconfigured without editing code.

# --- PostgreSQL ---
POSTGRES_USER=visionops
POSTGRES_PASSWORD=visionops
POSTGRES_DB=visionops
POSTGRES_PORT=5432

# --- Backend API ---
# Built automatically from the Postgres variables above inside docker-compose.yml,
# override only if you need a different value for local (non-Docker) development.
DATABASE_URL=postgresql+psycopg2://visionops:visionops@localhost:5432/visionops
MODEL_PATH=/app/models/visionops_ppe.pt
CONFIDENCE_THRESHOLD=0.35
DEVICE=cpu
MEDIA_STORAGE_DIR=/app/media
MAX_UPLOAD_SIZE_MB=100
VIDEO_FRAME_SAMPLE_RATE=5
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
BACKEND_PORT=8000

# --- Frontend ---
VITE_API_BASE_URL=/api/v1
FRONTEND_PORT=8080
